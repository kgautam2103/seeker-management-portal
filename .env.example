# Copy to .env.local for development. Never commit .env.local.

# --- Supabase (public; RLS is the guard) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=            # from `npx supabase start` output, or the project's anon/publishable key
# --- Supabase (server only; bypasses RLS — jobs and webhooks) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Inngest (local dev server needs neither; production values come from the Vercel integration) ---
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Sentry (optional; disabled when unset) ---
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- Phase 1 integrations (not used by the scaffold yet) ---
EVENTBRITE_PRIVATE_TOKEN=                 # one key with access to all organizations (AD-12)
GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON=       # base64 of the service-account key used to read the import sheet
